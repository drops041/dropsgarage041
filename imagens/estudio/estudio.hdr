–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{