–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{