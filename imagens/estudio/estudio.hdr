–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{–––{